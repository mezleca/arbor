#!/usr/bin/env python3

import argparse
import json
import os
import platform
import shutil
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent
BUILD_DIR = ROOT / "build"
SYSTEM = platform.system()


def run(command: list[str]) -> None:
    display = subprocess.list2cmdline(command)
    print(f"exec: {display}", flush=True)
    result = subprocess.run(
        command,
        cwd=ROOT,
        check=False,
    )

    if result.returncode != 0:
        print(f"[ez] command failed with exit code {result.returncode}")
        sys.exit(result.returncode)


def require_tool(name: str) -> None:
    if shutil.which(name) is not None:
        return

    print(f"[ez] required tool not found: {name}")
    sys.exit(1)


def init() -> None:
    for tool in ("git", "cmake", "ninja", "clang-format"):
        require_tool(tool)

    if not (ROOT / ".gitmodules").exists():
        return

    print("[ez] initializing submodules...")
    run(["git", "submodule", "update", "--init", "--recursive"])


def copy_compile_commands(build_dir: Path) -> None:
    source = build_dir / "compile_commands.json"
    if source.exists():
        shutil.copy2(source, BUILD_DIR / "compile_commands.json")


def configure(name: str, build_type: str, backend: str, tests: bool) -> Path:
    build_dir = ROOT / "build" / f"{build_type.lower()}-{name}"
    sccache = shutil.which("sccache") or ""
    command = [
        "cmake", "-S", str(ROOT), "-B", str(build_dir), "-G", "Ninja",
        f"-DCMAKE_BUILD_TYPE={build_type}",
        f"-DCMAKE_C_COMPILER_LAUNCHER={sccache}",
        f"-DCMAKE_CXX_COMPILER_LAUNCHER={sccache}",
        f"-DARBOR_ENABLE_SANITIZERS={'ON' if build_type == 'Debug' else 'OFF'}",
        f"-DARBOR_BUILD_TESTS={'ON' if tests else 'OFF'}",
        f"-DARBOR_BUILD_EXAMPLES={'OFF' if tests or backend == 'core' else 'ON'}",
        f"-DARBOR_BUILD_SDL={'ON' if backend in ('sdl', 'all') else 'OFF'}",
        f"-DARBOR_BUILD_RAYLIB={'ON' if backend in ('raylib', 'all') else 'OFF'}",
    ]
    if backend in ("raylib", "all") and SYSTEM == "Linux":
        command.append("-DGLFW_BUILD_WAYLAND=ON")
    run(command)
    return build_dir


def build(build_type: str, backend: str, tests: bool = False) -> Path:
    name = "tests" if tests else backend
    build_dir = configure(name, build_type, backend, tests)
    run(["cmake", "--build", str(build_dir), "--parallel"])
    copy_compile_commands(build_dir)
    return build_dir


def format_code() -> None:
    source_files = sorted(
        str(path.relative_to(ROOT))
        for directory in ("src", "include", "tests", "examples")
        for path in (ROOT / directory).rglob("*")
        if path.is_file() and path.suffix in (".h", ".hpp", ".cpp", ".cc", ".cxx")
    )
    run(["clang-format", "-i", *source_files])


def check(build_type: str, backend: str, fix: bool) -> None:
    require_tool("clang-tidy")

    build_dir = build(build_type, backend, tests=True)
    source_files = sorted(
        {
            str(path.relative_to(ROOT))
            for entry in json.loads((build_dir / "compile_commands.json").read_text())
            if (path := Path(entry["file"])).suffix == ".cpp"
            and (path.is_relative_to(ROOT / "src") or path.is_relative_to(ROOT / "tests"))
        }
    )

    if not source_files:
        print("[ez] no c++ source files found")
        sys.exit(1)

    if SYSTEM == "Linux" and shutil.which("run-clang-tidy") is not None:
        command = [
            "run-clang-tidy",
            "-p", str(build_dir),
            "-config-file", str(ROOT / ".clang-tidy"),
            "-quiet",
            "-hide-progress",
            "-j", str(os.cpu_count() or 1),
        ]
        if fix:
            command.append("-fix")
        command.extend(source_files)
    else:
        command = [
            "clang-tidy",
            f"-p={build_dir}",
            f"--config-file={ROOT / '.clang-tidy'}",
            "--quiet",
        ]
        if fix:
            command.append("--fix")
        command.extend(source_files)

    run(command)


def main() -> None:
    parser = argparse.ArgumentParser(prog="ez")
    subparsers = parser.add_subparsers(dest="command", required=True)

    for command in ("build", "tests", "check"):
        command_parser = subparsers.add_parser(command)
        command_parser.add_argument("--backend", choices=("core", "sdl", "raylib", "all"), default="core")
        command_parser.add_argument("--type", choices=("debug", "release"), default="debug")
        if command == "check":
            command_parser.add_argument("--fix", action="store_true")

    subparsers.add_parser("init")
    subparsers.add_parser("format")

    run_parser = subparsers.add_parser("run")
    run_parser.add_argument("backend", choices=("sdl", "raylib"))
    run_parser.add_argument("--type", choices=("debug", "release"), default="debug")

    args = parser.parse_args()

    if args.command == "init":
        init()
        return

    if args.command == "format":
        format_code()
        return

    if args.command == "check":
        check(args.type.capitalize(), args.backend, args.fix)
        return

    build_type = args.type.capitalize()

    if args.command == "build":
        build(build_type, args.backend)
    elif args.command == "tests":
        build_dir = build(build_type, args.backend, tests=True)
        run(["ctest", "--test-dir", str(build_dir), "--output-on-failure"])
    else:
        build_dir = build(build_type, args.backend)
        run([str(build_dir / "examples" / f"arbor-example-{args.backend}")])


if __name__ == "__main__":
    main()
